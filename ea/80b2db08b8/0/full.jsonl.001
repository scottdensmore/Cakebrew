{"timestamp":"2026-09-07T23:37:24.527Z","ordinal":19791,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a055ce-e4d9-77c1-ac18-0944a8c71200","turn_id":"01a07e3a-7088-74f3-8263-cbdd479f00a0","item":{"type":"CommandExecution","id":"exec-71292f32-1c9e-49d6-86c5-13044a4dcf45","process_id":"10858","command":["/bin/zsh","-lc","git -C .worktrees/issue-142-l10n diff --check; git -C .worktrees/issue-143-search diff --check; git -C .worktrees/search-clear-cancellation diff --check; shasum -a 256 .codex/config.toml workflow.md; cat .worktrees/issue-142-l10n/scripts/localization-debt.json; sed -n '1,235p' .worktrees/issue-142-l10n/scripts/tests/localization-debt-tests.rb"],"cwd":"file:///Users/scottdensmore/Developer/scottdensmore/cakebrew","parsed_cmd":[{"type":"unknown","cmd":"git -C .worktrees/issue-142-l10n diff --check; git -C .worktrees/issue-143-search diff --check; git -C .worktrees/search-clear-cancellation diff --check; shasum -a 256 .codex/config.toml workflow.md; cat .worktrees/issue-142-l10n/scripts/localization-debt.json; sed -n '1,235p' .worktrees/issue-142-l10n/scripts/tests/localization-debt-tests.rb"}],"source":"unified_exec_startup","status":"completed","stdout":"13249b669f2d19cbc6a06ffb129b44d0277f5ea7652cb7dd2a93526f8397127b  .codex/config.toml\nb72afd7ce6647dabe1a6021deabc10d14f30a6539fd152b0df661866e44c3fdf  workflow.md\n{\n  \"version\": 1,\n  \"placeholders\": [\n    { \"key\": \"Remove Unused Dependencies\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" },\n    { \"key\": \"Checking unused dependencies…\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" },\n    { \"key\": \"Remove Reviewed Dependencies\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" }\n  ],\n  \"intentional\": [\n    { \"key\": \"Cakebrew\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Application product name.\" },\n    { \"key\": \"Casks\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Homebrew term kept untranslated by AGENTS.md.\" },\n    { \"key\": \"Mac App Store\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Apple storefront product name.\" },\n    { \"key\": \"VS Code\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Editor product name.\" }\n  ]\n}\n#!/usr/bin/env ruby\n# Focused, hermetic reporter tests; no app or Homebrew process is launched.\nrequire 'minitest/autorun'\nrequire 'tmpdir'\nrequire 'fileutils'\nrequire 'json'\nrequire 'open3'\nrequire 'rbconfig'\n\nclass LocalizationDebtTests < Minitest::Test\n  ROOT = File.expand_path('../..', __dir__)\n  SCRIPT = File.join(ROOT, 'scripts/localization-debt.rb')\n  LOCALES = %w[de en fr it pt zh-Hans].freeze\n\n  def setup\n    @root = Dir.mktmpdir('cakebrew-l10n-test-')\n    @metadata = File.join(@root, 'metadata.json')\n    LOCALES.each { |locale| strings(locale, '\"z\" = \"z\"; \"a\" = \"a\"; \"brand\" = \"Cakebrew\"; \"different\" = \"English\";') }\n    strings('de', '\"z\" = \"z\"; \"a\" = \"a\"; \"brand\" = \"Cakebrew\"; \"different\" = \"Deutsch\";')\n    metadata('placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'New English placeholder.' }],\n             'intentional' => [{ 'key' => 'brand', 'locales' => ['de'], 'reason' => 'Product name.' }])\n  end\n\n  def teardown\n    FileUtils.remove_entry(@root)\n  end\n\n  def strings(locale, source)\n    path = File.join(@root, 'Cakebrew', \"#{locale}.lproj\", 'Localizable.strings')\n    FileUtils.mkdir_p(File.dirname(path))\n    File.write(path, source)\n  end\n\n  def metadata(overrides = {})\n    File.write(@metadata, JSON.generate({ 'version' => 1, 'placeholders' => [], 'intentional' => [] }.merge(overrides)))\n  end\n\n  def run_report(*arguments, env: {}, default_root: false)\n    paths = default_root ? [] : ['--root', @root, '--metadata', @metadata]\n    Open3.capture3(env, RbConfig.ruby, SCRIPT, *paths, *arguments, chdir: @root)\n  end\n\n  def report\n    out, err, status = run_report('--json')\n    assert status.success?, err\n    JSON.parse(out)\n  end\n\n  def assert_invalid(fragment)\n    out, err, status = run_report('--json')\n    refute status.success?, 'Invalid input must fail instead of reporting zero debt.'\n    assert_empty out\n    assert_includes err, fragment\n  end\n\n  def test_classification_counts_and_debt_do_not_fail\n    data = report\n    assert_equal 4, data.fetch('english_keys')\n    de = data.fetch('locales').fetch('de')\n    assert_equal ['a'], de.fetch('placeholders')\n    assert_equal ['brand'], de.fetch('intentional')\n    assert_equal ['z'], de.fetch('unreviewed_equal')\n    assert_equal ['different'], de.fetch('different')\n    assert_equal [], de.fetch('missing')\n    assert_equal [], de.fetch('extra')\n    assert_equal 1, de.fetch('counts').fetch('placeholders')\n    assert_equal %w[a brand different z], data.fetch('locales').fetch('fr').fetch('unreviewed_equal')\n    assert_equal %w[de fr it pt zh-Hans], data.fetch('locales').keys\n  end\n\n  def test_missing_and_extra_are_separate\n    strings('fr', '\"a\" = \"a\"; \"extra\" = \"Bonjour\";')\n    fr = report.fetch('locales').fetch('fr')\n    assert_equal %w[brand different z], fr.fetch('missing')\n    assert_equal ['extra'], fr.fetch('extra')\n    assert_equal ['a'], fr.fetch('unreviewed_equal')\n  end\n\n  def test_native_comments_escapes_and_utf16\n    metadata\n    source = '/* \"fake\" = \"ignored\"; */ \"a\\\\U0062\" = \"line\\\\n\\\\\"quoted\\\\\"\"; // comment' + \"\\n\" + '\"\\\\U4F60\" = \"\\\\U597D\";'\n    LOCALES.each { |locale| strings(locale, source) }\n    path = File.join(@root, 'Cakebrew/de.lproj/Localizable.strings')\n    File.binwrite(path, \"\\xFF\\xFE\".b + source.encode('UTF-16LE').b)\n    assert_equal ['ab', '你'], report.fetch('locales').fetch('de').fetch('unreviewed_equal')\n  end\n\n  def test_duplicate_literal_and_escaped_keys_are_rejected\n    ['\"a\" = \"one\"; \"a\" = \"two\";', '\"a\" = \"one\"; \"\\\\U0061\" = \"two\";'].each do |source|\n      strings('fr', source)\n      assert_invalid('duplicate key')\n    end\n  end\n\n  def test_malformed_or_non_string_tables_fail\n    ['\"a\" = \"unterminated;', '\"a\" = (\"array\");', '\"a\" = { \"nested\" = \"value\"; };'].each do |source|\n      strings('fr', source)\n      assert_invalid('fr')\n    end\n  end\n\n  def test_locale_inventory_cannot_silently_shrink_or_expand\n    FileUtils.rm(File.join(@root, 'Cakebrew/fr.lproj/Localizable.strings'))\n    assert_invalid('locale inventory')\n    strings('fr', '\"a\" = \"a\";')\n    strings('es', '\"a\" = \"a\";')\n    assert_invalid('locale inventory')\n  end\n\n  def test_metadata_is_strict_and_stale_entries_fail\n    cases = [\n      { 'version' => 2 }, { 'unknown' => [] }, { 'placeholders' => {} },\n      { 'placeholders' => [{ 'key' => 'absent', 'locales' => ['de'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['en'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => [], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de', 'de'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => ' ' }] },\n      { 'placeholders' => [{ 'key' => 'different', 'locales' => ['de'], 'reason' => 'stale' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'x', 'typo' => true }] }\n    ]\n    cases.each { |value| metadata(value); assert_invalid('metadata') }\n    entry = { 'key' => 'a', 'locales' => ['de'], 'reason' => 'x' }\n    metadata('placeholders' => [entry], 'intentional' => [entry])\n    assert_invalid('metadata')\n    metadata('placeholders' => [entry, entry])\n    assert_invalid('metadata')\n    File.write(@metadata, '{bad')\n    assert_invalid('metadata')\n  end\n\n  def test_markdown_is_deterministic_safe_and_summary_matches_stdout\n    metadata\n    LOCALES.each { |locale| strings(locale, '\"::error::\\\\n<script>`&\" = \"same\";') }\n    summary = File.join(@root, 'summary.md')\n    out, err, status = run_report('--summary', summary)\n    assert status.success?, err\n    assert_includes out, 'Different from English is not a translation-quality assessment.'\n    assert_includes out, '&lt;script&gt;'\n    refute_match(/^::error::/, out)\n    refute_includes out, '<script>'\n    assert_equal out, File.read(summary)\n    assert_equal out, run_report.first\n  end\n\n  def test_invalid_input_does_not_write_summary\n    strings('de', 'broken')\n    summary = File.join(@root, 'summary.md')\n    _, _, status = run_report('--summary', summary)\n    refute status.success?\n    refute File.exist?(summary)\n  end\n\n  def test_metadata_duplicate_json_fields_and_noninteger_version_fail\n    File.write(@metadata, '{\"version\":2,\"version\":1,\"placeholders\":[],\"intentional\":[]}')\n    assert_invalid('metadata')\n    metadata('version' => 1.0)\n    assert_invalid('metadata')\n  end\n\n  def test_bounded_input_invalid_encoding_and_cli_errors\n    strings('fr', ' ' * (2 * 1024 * 1024 + 1))\n    assert_invalid('exceeds')\n    strings('fr', \"\\xFF\".b)\n    assert_invalid('encoding')\n    _, err, status = run_report('--unknown')\n    refute status.success?\n    assert_includes err, 'invalid option'\n    _, err, status = run_report('unexpected')\n    refute status.success?\n    assert_includes err, 'unexpected arguments'\n  end\n\n  def test_default_paths_are_independent_of_current_directory_and_real_counts_match\n    out, err, status = run_report('--json', default_root: true)\n    assert status.success?, err\n    data = JSON.parse(out)\n    assert_equal 254, data.fetch('english_keys')\n    { 'de' => 127, 'fr' => 124, 'it' => 126, 'pt' => 126, 'zh-Hans' => 137 }.each do |locale, expected|\n      row = data.fetch('locales').fetch(locale)\n      assert_equal expected, %w[placeholders intentional unreviewed_equal].sum { |category| row.fetch(category).length }\n      assert_empty row.fetch('missing')\n      assert_empty row.fetch('extra')\n      assert_includes row.fetch('placeholders'), 'Remove Reviewed Dependencies'\n      assert_includes row.fetch('intentional'), 'Cakebrew'\n    end\n  end\n\n  def test_native_formulae_values_preserve_existing_translations\n    expected = { 'de' => 'Formeln', 'fr' => 'Formules', 'it' => 'Formule', 'pt' => 'Fórmulas', 'zh-Hans' => 'Formulae' }\n    actual = expected.keys.to_h do |locale|\n      path = File.join(ROOT, 'Cakebrew', \"#{locale}.lproj\", 'Localizable.strings')\n      out, err, status = Open3.capture3('/usr/bin/plutil', '-convert', 'json', '-o', '-', '--', path)\n      assert status.success?, err\n      [locale, JSON.parse(out).fetch('Formulae')]\n    end\n    assert_equal expected, actual\n  end\n\n  def test_ci_runs_tests_then_report_without_masking_errors\n    source = File.read(File.join(ROOT, '.github/workflows/ci.yml'))\n    assert_match(/ruby scripts\\/tests\\/localization-debt-tests\\.rb/, source)\n    assert_match(/ruby scripts\\/localization-debt\\.rb --summary \"\\$GITHUB_STEP_SUMMARY\"/, source)\n    assert_operator source.index('ruby scripts/tests/localization-debt-tests.rb'), :<, source.index('ruby scripts/localization-debt.rb')\n    refute_includes source, 'continue-on-error'\n  end\nend\n","stderr":"","aggregated_output":"13249b669f2d19cbc6a06ffb129b44d0277f5ea7652cb7dd2a93526f8397127b  .codex/config.toml\nb72afd7ce6647dabe1a6021deabc10d14f30a6539fd152b0df661866e44c3fdf  workflow.md\n{\n  \"version\": 1,\n  \"placeholders\": [\n    { \"key\": \"Remove Unused Dependencies\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" },\n    { \"key\": \"Checking unused dependencies…\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" },\n    { \"key\": \"Remove Reviewed Dependencies\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" }\n  ],\n  \"intentional\": [\n    { \"key\": \"Cakebrew\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Application product name.\" },\n    { \"key\": \"Casks\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Homebrew term kept untranslated by AGENTS.md.\" },\n    { \"key\": \"Mac App Store\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Apple storefront product name.\" },\n    { \"key\": \"VS Code\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Editor product name.\" }\n  ]\n}\n#!/usr/bin/env ruby\n# Focused, hermetic reporter tests; no app or Homebrew process is launched.\nrequire 'minitest/autorun'\nrequire 'tmpdir'\nrequire 'fileutils'\nrequire 'json'\nrequire 'open3'\nrequire 'rbconfig'\n\nclass LocalizationDebtTests < Minitest::Test\n  ROOT = File.expand_path('../..', __dir__)\n  SCRIPT = File.join(ROOT, 'scripts/localization-debt.rb')\n  LOCALES = %w[de en fr it pt zh-Hans].freeze\n\n  def setup\n    @root = Dir.mktmpdir('cakebrew-l10n-test-')\n    @metadata = File.join(@root, 'metadata.json')\n    LOCALES.each { |locale| strings(locale, '\"z\" = \"z\"; \"a\" = \"a\"; \"brand\" = \"Cakebrew\"; \"different\" = \"English\";') }\n    strings('de', '\"z\" = \"z\"; \"a\" = \"a\"; \"brand\" = \"Cakebrew\"; \"different\" = \"Deutsch\";')\n    metadata('placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'New English placeholder.' }],\n             'intentional' => [{ 'key' => 'brand', 'locales' => ['de'], 'reason' => 'Product name.' }])\n  end\n\n  def teardown\n    FileUtils.remove_entry(@root)\n  end\n\n  def strings(locale, source)\n    path = File.join(@root, 'Cakebrew', \"#{locale}.lproj\", 'Localizable.strings')\n    FileUtils.mkdir_p(File.dirname(path))\n    File.write(path, source)\n  end\n\n  def metadata(overrides = {})\n    File.write(@metadata, JSON.generate({ 'version' => 1, 'placeholders' => [], 'intentional' => [] }.merge(overrides)))\n  end\n\n  def run_report(*arguments, env: {}, default_root: false)\n    paths = default_root ? [] : ['--root', @root, '--metadata', @metadata]\n    Open3.capture3(env, RbConfig.ruby, SCRIPT, *paths, *arguments, chdir: @root)\n  end\n\n  def report\n    out, err, status = run_report('--json')\n    assert status.success?, err\n    JSON.parse(out)\n  end\n\n  def assert_invalid(fragment)\n    out, err, status = run_report('--json')\n    refute status.success?, 'Invalid input must fail instead of reporting zero debt.'\n    assert_empty out\n    assert_includes err, fragment\n  end\n\n  def test_classification_counts_and_debt_do_not_fail\n    data = report\n    assert_equal 4, data.fetch('english_keys')\n    de = data.fetch('locales').fetch('de')\n    assert_equal ['a'], de.fetch('placeholders')\n    assert_equal ['brand'], de.fetch('intentional')\n    assert_equal ['z'], de.fetch('unreviewed_equal')\n    assert_equal ['different'], de.fetch('different')\n    assert_equal [], de.fetch('missing')\n    assert_equal [], de.fetch('extra')\n    assert_equal 1, de.fetch('counts').fetch('placeholders')\n    assert_equal %w[a brand different z], data.fetch('locales').fetch('fr').fetch('unreviewed_equal')\n    assert_equal %w[de fr it pt zh-Hans], data.fetch('locales').keys\n  end\n\n  def test_missing_and_extra_are_separate\n    strings('fr', '\"a\" = \"a\"; \"extra\" = \"Bonjour\";')\n    fr = report.fetch('locales').fetch('fr')\n    assert_equal %w[brand different z], fr.fetch('missing')\n    assert_equal ['extra'], fr.fetch('extra')\n    assert_equal ['a'], fr.fetch('unreviewed_equal')\n  end\n\n  def test_native_comments_escapes_and_utf16\n    metadata\n    source = '/* \"fake\" = \"ignored\"; */ \"a\\\\U0062\" = \"line\\\\n\\\\\"quoted\\\\\"\"; // comment' + \"\\n\" + '\"\\\\U4F60\" = \"\\\\U597D\";'\n    LOCALES.each { |locale| strings(locale, source) }\n    path = File.join(@root, 'Cakebrew/de.lproj/Localizable.strings')\n    File.binwrite(path, \"\\xFF\\xFE\".b + source.encode('UTF-16LE').b)\n    assert_equal ['ab', '你'], report.fetch('locales').fetch('de').fetch('unreviewed_equal')\n  end\n\n  def test_duplicate_literal_and_escaped_keys_are_rejected\n    ['\"a\" = \"one\"; \"a\" = \"two\";', '\"a\" = \"one\"; \"\\\\U0061\" = \"two\";'].each do |source|\n      strings('fr', source)\n      assert_invalid('duplicate key')\n    end\n  end\n\n  def test_malformed_or_non_string_tables_fail\n    ['\"a\" = \"unterminated;', '\"a\" = (\"array\");', '\"a\" = { \"nested\" = \"value\"; };'].each do |source|\n      strings('fr', source)\n      assert_invalid('fr')\n    end\n  end\n\n  def test_locale_inventory_cannot_silently_shrink_or_expand\n    FileUtils.rm(File.join(@root, 'Cakebrew/fr.lproj/Localizable.strings'))\n    assert_invalid('locale inventory')\n    strings('fr', '\"a\" = \"a\";')\n    strings('es', '\"a\" = \"a\";')\n    assert_invalid('locale inventory')\n  end\n\n  def test_metadata_is_strict_and_stale_entries_fail\n    cases = [\n      { 'version' => 2 }, { 'unknown' => [] }, { 'placeholders' => {} },\n      { 'placeholders' => [{ 'key' => 'absent', 'locales' => ['de'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['en'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => [], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de', 'de'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => ' ' }] },\n      { 'placeholders' => [{ 'key' => 'different', 'locales' => ['de'], 'reason' => 'stale' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'x', 'typo' => true }] }\n    ]\n    cases.each { |value| metadata(value); assert_invalid('metadata') }\n    entry = { 'key' => 'a', 'locales' => ['de'], 'reason' => 'x' }\n    metadata('placeholders' => [entry], 'intentional' => [entry])\n    assert_invalid('metadata')\n    metadata('placeholders' => [entry, entry])\n    assert_invalid('metadata')\n    File.write(@metadata, '{bad')\n    assert_invalid('metadata')\n  end\n\n  def test_markdown_is_deterministic_safe_and_summary_matches_stdout\n    metadata\n    LOCALES.each { |locale| strings(locale, '\"::error::\\\\n<script>`&\" = \"same\";') }\n    summary = File.join(@root, 'summary.md')\n    out, err, status = run_report('--summary', summary)\n    assert status.success?, err\n    assert_includes out, 'Different from English is not a translation-quality assessment.'\n    assert_includes out, '&lt;script&gt;'\n    refute_match(/^::error::/, out)\n    refute_includes out, '<script>'\n    assert_equal out, File.read(summary)\n    assert_equal out, run_report.first\n  end\n\n  def test_invalid_input_does_not_write_summary\n    strings('de', 'broken')\n    summary = File.join(@root, 'summary.md')\n    _, _, status = run_report('--summary', summary)\n    refute status.success?\n    refute File.exist?(summary)\n  end\n\n  def test_metadata_duplicate_json_fields_and_noninteger_version_fail\n    File.write(@metadata, '{\"version\":2,\"version\":1,\"placeholders\":[],\"intentional\":[]}')\n    assert_invalid('metadata')\n    metadata('version' => 1.0)\n    assert_invalid('metadata')\n  end\n\n  def test_bounded_input_invalid_encoding_and_cli_errors\n    strings('fr', ' ' * (2 * 1024 * 1024 + 1))\n    assert_invalid('exceeds')\n    strings('fr', \"\\xFF\".b)\n    assert_invalid('encoding')\n    _, err, status = run_report('--unknown')\n    refute status.success?\n    assert_includes err, 'invalid option'\n    _, err, status = run_report('unexpected')\n    refute status.success?\n    assert_includes err, 'unexpected arguments'\n  end\n\n  def test_default_paths_are_independent_of_current_directory_and_real_counts_match\n    out, err, status = run_report('--json', default_root: true)\n    assert status.success?, err\n    data = JSON.parse(out)\n    assert_equal 254, data.fetch('english_keys')\n    { 'de' => 127, 'fr' => 124, 'it' => 126, 'pt' => 126, 'zh-Hans' => 137 }.each do |locale, expected|\n      row = data.fetch('locales').fetch(locale)\n      assert_equal expected, %w[placeholders intentional unreviewed_equal].sum { |category| row.fetch(category).length }\n      assert_empty row.fetch('missing')\n      assert_empty row.fetch('extra')\n      assert_includes row.fetch('placeholders'), 'Remove Reviewed Dependencies'\n      assert_includes row.fetch('intentional'), 'Cakebrew'\n    end\n  end\n\n  def test_native_formulae_values_preserve_existing_translations\n    expected = { 'de' => 'Formeln', 'fr' => 'Formules', 'it' => 'Formule', 'pt' => 'Fórmulas', 'zh-Hans' => 'Formulae' }\n    actual = expected.keys.to_h do |locale|\n      path = File.join(ROOT, 'Cakebrew', \"#{locale}.lproj\", 'Localizable.strings')\n      out, err, status = Open3.capture3('/usr/bin/plutil', '-convert', 'json', '-o', '-', '--', path)\n      assert status.success?, err\n      [locale, JSON.parse(out).fetch('Formulae')]\n    end\n    assert_equal expected, actual\n  end\n\n  def test_ci_runs_tests_then_report_without_masking_errors\n    source = File.read(File.join(ROOT, '.github/workflows/ci.yml'))\n    assert_match(/ruby scripts\\/tests\\/localization-debt-tests\\.rb/, source)\n    assert_match(/ruby scripts\\/localization-debt\\.rb --summary \"\\$GITHUB_STEP_SUMMARY\"/, source)\n    assert_operator source.index('ruby scripts/tests/localization-debt-tests.rb'), :<, source.index('ruby scripts/localization-debt.rb')\n    refute_includes source, 'continue-on-error'\n  end\nend\n","exit_code":0,"duration":{"secs":7,"nanos":666045741},"formatted_output":"13249b669f2d19cbc6a06ffb129b44d0277f5ea7652cb7dd2a93526f8397127b  .codex/config.toml\nb72afd7ce6647dabe1a6021deabc10d14f30a6539fd152b0df661866e44c3fdf  workflow.md\n{\n  \"version\": 1,\n  \"placeholders\": [\n    { \"key\": \"Remove Unused Dependencies\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" },\n    { \"key\": \"Checking unused dependencies…\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" },\n    { \"key\": \"Remove Reviewed Dependencies\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\" }\n  ],\n  \"intentional\": [\n    { \"key\": \"Cakebrew\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Application product name.\" },\n    { \"key\": \"Casks\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Homebrew term kept untranslated by AGENTS.md.\" },\n    { \"key\": \"Mac App Store\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Apple storefront product name.\" },\n    { \"key\": \"VS Code\", \"locales\": [\"de\", \"fr\", \"it\", \"pt\", \"zh-Hans\"], \"reason\": \"Editor product name.\" }\n  ]\n}\n#!/usr/bin/env ruby\n# Focused, hermetic reporter tests; no app or Homebrew process is launched.\nrequire 'minitest/autorun'\nrequire 'tmpdir'\nrequire 'fileutils'\nrequire 'json'\nrequire 'open3'\nrequire 'rbconfig'\n\nclass LocalizationDebtTests < Minitest::Test\n  ROOT = File.expand_path('../..', __dir__)\n  SCRIPT = File.join(ROOT, 'scripts/localization-debt.rb')\n  LOCALES = %w[de en fr it pt zh-Hans].freeze\n\n  def setup\n    @root = Dir.mktmpdir('cakebrew-l10n-test-')\n    @metadata = File.join(@root, 'metadata.json')\n    LOCALES.each { |locale| strings(locale, '\"z\" = \"z\"; \"a\" = \"a\"; \"brand\" = \"Cakebrew\"; \"different\" = \"English\";') }\n    strings('de', '\"z\" = \"z\"; \"a\" = \"a\"; \"brand\" = \"Cakebrew\"; \"different\" = \"Deutsch\";')\n    metadata('placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'New English placeholder.' }],\n             'intentional' => [{ 'key' => 'brand', 'locales' => ['de'], 'reason' => 'Product name.' }])\n  end\n\n  def teardown\n    FileUtils.remove_entry(@root)\n  end\n\n  def strings(locale, source)\n    path = File.join(@root, 'Cakebrew', \"#{locale}.lproj\", 'Localizable.strings')\n    FileUtils.mkdir_p(File.dirname(path))\n    File.write(path, source)\n  end\n\n  def metadata(overrides = {})\n    File.write(@metadata, JSON.generate({ 'version' => 1, 'placeholders' => [], 'intentional' => [] }.merge(overrides)))\n  end\n\n  def run_report(*arguments, env: {}, default_root: false)\n    paths = default_root ? [] : ['--root', @root, '--metadata', @metadata]\n    Open3.capture3(env, RbConfig.ruby, SCRIPT, *paths, *arguments, chdir: @root)\n  end\n\n  def report\n    out, err, status = run_report('--json')\n    assert status.success?, err\n    JSON.parse(out)\n  end\n\n  def assert_invalid(fragment)\n    out, err, status = run_report('--json')\n    refute status.success?, 'Invalid input must fail instead of reporting zero debt.'\n    assert_empty out\n    assert_includes err, fragment\n  end\n\n  def test_classification_counts_and_debt_do_not_fail\n    data = report\n    assert_equal 4, data.fetch('english_keys')\n    de = data.fetch('locales').fetch('de')\n    assert_equal ['a'], de.fetch('placeholders')\n    assert_equal ['brand'], de.fetch('intentional')\n    assert_equal ['z'], de.fetch('unreviewed_equal')\n    assert_equal ['different'], de.fetch('different')\n    assert_equal [], de.fetch('missing')\n    assert_equal [], de.fetch('extra')\n    assert_equal 1, de.fetch('counts').fetch('placeholders')\n    assert_equal %w[a brand different z], data.fetch('locales').fetch('fr').fetch('unreviewed_equal')\n    assert_equal %w[de fr it pt zh-Hans], data.fetch('locales').keys\n  end\n\n  def test_missing_and_extra_are_separate\n    strings('fr', '\"a\" = \"a\"; \"extra\" = \"Bonjour\";')\n    fr = report.fetch('locales').fetch('fr')\n    assert_equal %w[brand different z], fr.fetch('missing')\n    assert_equal ['extra'], fr.fetch('extra')\n    assert_equal ['a'], fr.fetch('unreviewed_equal')\n  end\n\n  def test_native_comments_escapes_and_utf16\n    metadata\n    source = '/* \"fake\" = \"ignored\"; */ \"a\\\\U0062\" = \"line\\\\n\\\\\"quoted\\\\\"\"; // comment' + \"\\n\" + '\"\\\\U4F60\" = \"\\\\U597D\";'\n    LOCALES.each { |locale| strings(locale, source) }\n    path = File.join(@root, 'Cakebrew/de.lproj/Localizable.strings')\n    File.binwrite(path, \"\\xFF\\xFE\".b + source.encode('UTF-16LE').b)\n    assert_equal ['ab', '你'], report.fetch('locales').fetch('de').fetch('unreviewed_equal')\n  end\n\n  def test_duplicate_literal_and_escaped_keys_are_rejected\n    ['\"a\" = \"one\"; \"a\" = \"two\";', '\"a\" = \"one\"; \"\\\\U0061\" = \"two\";'].each do |source|\n      strings('fr', source)\n      assert_invalid('duplicate key')\n    end\n  end\n\n  def test_malformed_or_non_string_tables_fail\n    ['\"a\" = \"unterminated;', '\"a\" = (\"array\");', '\"a\" = { \"nested\" = \"value\"; };'].each do |source|\n      strings('fr', source)\n      assert_invalid('fr')\n    end\n  end\n\n  def test_locale_inventory_cannot_silently_shrink_or_expand\n    FileUtils.rm(File.join(@root, 'Cakebrew/fr.lproj/Localizable.strings'))\n    assert_invalid('locale inventory')\n    strings('fr', '\"a\" = \"a\";')\n    strings('es', '\"a\" = \"a\";')\n    assert_invalid('locale inventory')\n  end\n\n  def test_metadata_is_strict_and_stale_entries_fail\n    cases = [\n      { 'version' => 2 }, { 'unknown' => [] }, { 'placeholders' => {} },\n      { 'placeholders' => [{ 'key' => 'absent', 'locales' => ['de'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['en'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => [], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de', 'de'], 'reason' => 'x' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => ' ' }] },\n      { 'placeholders' => [{ 'key' => 'different', 'locales' => ['de'], 'reason' => 'stale' }] },\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'x', 'typo' => true }] }\n    ]\n    cases.each { |value| metadata(value); assert_invalid('metadata') }\n    entry = { 'key' => 'a', 'locales' => ['de'], 'reason' => 'x' }\n    metadata('placeholders' => [entry], 'intentional' => [entry])\n    assert_invalid('metadata')\n    metadata('placeholders' => [entry, entry])\n    assert_invalid('metadata')\n    File.write(@metadata, '{bad')\n    assert_invalid('metadata')\n  end\n\n  def test_markdown_is_deterministic_safe_and_summary_matches_stdout\n    metadata\n    LOCALES.each { |locale| strings(locale, '\"::error::\\\\n<script>`&\" = \"same\";') }\n    summary = File.join(@root, 'summary.md')\n    out, err, status = run_report('--summary', summary)\n    assert status.success?, err\n    assert_includes out, 'Different from English is not a translation-quality assessment.'\n    assert_includes out, '&lt;script&gt;'\n    refute_match(/^::error::/, out)\n    refute_includes out, '<script>'\n    assert_equal out, File.read(summary)\n    assert_equal out, run_report.first\n  end\n\n  def test_invalid_input_does_not_write_summary\n    strings('de', 'broken')\n    summary = File.join(@root, 'summary.md')\n    _, _, status = run_report('--summary', summary)\n    refute status.success?\n    refute File.exist?(summary)\n  end\n\n  def test_metadata_duplicate_json_fields_and_noninteger_version_fail\n    File.write(@metadata, '{\"version\":2,\"version\":1,\"placeholders\":[],\"intentional\":[]}')\n    assert_invalid('metadata')\n    metadata('version' => 1.0)\n    assert_invalid('metadata')\n  end\n\n  def test_bounded_input_invalid_encoding_and_cli_errors\n    strings('fr', ' ' * (2 * 1024 * 1024 + 1))\n    assert_invalid('exceeds')\n    strings('fr', \"\\xFF\".b)\n    assert_invalid('encoding')\n    _, err, status = run_report('--unknown')\n    refute status.success?\n    assert_includes err, 'invalid option'\n    _, err, status = run_report('unexpected')\n    refute status.success?\n    assert_includes err, 'unexpected arguments'\n  end\n\n  def test_default_paths_are_independent_of_current_directory_and_real_counts_match\n    out, err, status = run_report('--json', default_root: true)\n    assert status.success?, err\n    data = JSON.parse(out)\n    assert_equal 254, data.fetch('english_keys')\n    { 'de' => 127, 'fr' => 124, 'it' => 126, 'pt' => 126, 'zh-Hans' => 137 }.each do |locale, expected|\n      row = data.fetch('locales').fetch(locale)\n      assert_equal expected, %w[placeholders intentional unreviewed_equal].sum { |category| row.fetch(category).length }\n      assert_empty row.fetch('missing')\n      assert_empty row.fetch('extra')\n      assert_includes row.fetch('placeholders'), 'Remove Reviewed Dependencies'\n      assert_includes row.fetch('intentional'), 'Cakebrew'\n    end\n  end\n\n  def test_native_formulae_values_preserve_existing_translations\n    expected = { 'de' => 'Formeln', 'fr' => 'Formules', 'it' => 'Formule', 'pt' => 'Fórmulas', 'zh-Hans' => 'Formulae' }\n    actual = expected.keys.to_h do |locale|\n      path = File.join(ROOT, 'Cakebrew', \"#{locale}.lproj\", 'Localizable.strings')\n      out, err, status = Open3.capture3('/usr/bin/plutil', '-convert', 'json', '-o', '-', '--', path)\n      assert status.success?, err\n      [locale, JSON.parse(out).fetch('Formulae')]\n    end\n    assert_equal expected, actual\n  end\n\n  def test_ci_runs_tests_then_report_without_masking_errors\n    source = File.read(File.join(ROOT, '.github/workflows/ci.yml'))\n    assert_match(/ruby scripts\\/tests\\/localization-debt-tests\\.rb/, source)\n    assert_match(/ruby scripts\\/localization-debt\\.rb --summary \"\\$GITHUB_STEP_SUMMARY\"/, source)\n    assert_operator source.index('ruby scripts/tests/localization-debt-tests.rb'), :<, source.index('ruby scripts/localization-debt.rb')\n    refute_includes source, 'continue-on-error'\n  end\nend\n"},"started_at_ms":1788824236857,"completed_at_ms":1788824244524}}
{"timestamp":"2026-09-07T23:37:26.126Z","ordinal":19792,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a07e3b-d76e-7fc0-94ca-2183e75a30dc","call_id":"call_mk4MbniYtOmqGa92jxzPkTCI","output":[{"type":"input_text","text":"Script completed\nWall time 9.7 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"ad4723\",\"wall_time_seconds\":7.666084959,\"exit_code\":0,\"original_token_count\":2479,\"output\":\"13249b669f2d19cbc6a06ffb129b44d0277f5ea7652cb7dd2a93526f8397127b  .codex/config.toml\\nb72afd7ce6647dabe1a6021deabc10d14f30a6539fd152b0df661866e44c3fdf  workflow.md\\n{\\n  \\\"version\\\": 1,\\n  \\\"placeholders\\\": [\\n    { \\\"key\\\": \\\"Remove Unused Dependencies\\\", \\\"locales\\\": [\\\"de\\\", \\\"fr\\\", \\\"it\\\", \\\"pt\\\", \\\"zh-Hans\\\"], \\\"reason\\\": \\\"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\\\" },\\n    { \\\"key\\\": \\\"Checking unused dependencies…\\\", \\\"locales\\\": [\\\"de\\\", \\\"fr\\\", \\\"it\\\", \\\"pt\\\", \\\"zh-Hans\\\"], \\\"reason\\\": \\\"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\\\" },\\n    { \\\"key\\\": \\\"Remove Reviewed Dependencies\\\", \\\"locales\\\": [\\\"de\\\", \\\"fr\\\", \\\"it\\\", \\\"pt\\\", \\\"zh-Hans\\\"], \\\"reason\\\": \\\"Unused dependency review shipped English placeholders under AGENTS.md localization policy.\\\" }\\n  ],\\n  \\\"intentional\\\": [\\n    { \\\"key\\\": \\\"Cakebrew\\\", \\\"locales\\\": [\\\"de\\\", \\\"fr\\\", \\\"it\\\", \\\"pt\\\", \\\"zh-Hans\\\"], \\\"reason\\\": \\\"Application product name.\\\" },\\n    { \\\"key\\\": \\\"Casks\\\", \\\"locales\\\": [\\\"de\\\", \\\"fr\\\", \\\"it\\\", \\\"pt\\\", \\\"zh-Hans\\\"], \\\"reason\\\": \\\"Homebrew term kept untranslated by AGENTS.md.\\\" },\\n    { \\\"key\\\": \\\"Mac App Store\\\", \\\"locales\\\": [\\\"de\\\", \\\"fr\\\", \\\"it\\\", \\\"pt\\\", \\\"zh-Hans\\\"], \\\"reason\\\": \\\"Apple storefront product name.\\\" },\\n    { \\\"key\\\": \\\"VS Code\\\", \\\"locales\\\": [\\\"de\\\", \\\"fr\\\", \\\"it\\\", \\\"pt\\\", \\\"zh-Hans\\\"], \\\"reason\\\": \\\"Editor product name.\\\" }\\n  ]\\n}\\n#!/usr/bin/env ruby\\n# Focused, hermetic reporter tests; no app or Homebrew process is launched.\\nrequire 'minitest/autorun'\\nrequire 'tmpdir'\\nrequire 'fileutils'\\nrequire 'json'\\nrequire 'open3'\\nrequire 'rbconfig'\\n\\nclass LocalizationDebtTests < Minitest::Test\\n  ROOT = File.expand_path('../..', __dir__)\\n  SCRIPT = File.join(ROOT, 'scripts/localization-debt.rb')\\n  LOCALES = %w[de en fr it pt zh-Hans].freeze\\n\\n  def setup\\n    @root = Dir.mktmpdir('cakebrew-l10n-test-')\\n    @metadata = File.join(@root, 'metadata.json')\\n    LOCALES.each { |locale| strings(locale, '\\\"z\\\" = \\\"z\\\"; \\\"a\\\" = \\\"a\\\"; \\\"brand\\\" = \\\"Cakebrew\\\"; \\\"different\\\" = \\\"English\\\";') }\\n    strings('de', '\\\"z\\\" = \\\"z\\\"; \\\"a\\\" = \\\"a\\\"; \\\"brand\\\" = \\\"Cakebrew\\\"; \\\"different\\\" = \\\"Deutsch\\\";')\\n    metadata('placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'New English placeholder.' }],\\n             'intentional' => [{ 'key' => 'brand', 'locales' => ['de'], 'reason' => 'Product name.' }])\\n  end\\n\\n  def teardown\\n    FileUtils.remove_entry(@root)\\n  end\\n\\n  def strings(locale, source)\\n    path = File.join(@root, 'Cakebrew', \\\"#{locale}.lproj\\\", 'Localizable.strings')\\n    FileUtils.mkdir_p(File.dirname(path))\\n    File.write(path, source)\\n  end\\n\\n  def metadata(overrides = {})\\n    File.write(@metadata, JSON.generate({ 'version' => 1, 'placeholders' => [], 'intentional' => [] }.merge(overrides)))\\n  end\\n\\n  def run_report(*arguments, env: {}, default_root: false)\\n    paths = default_root ? [] : ['--root', @root, '--metadata', @metadata]\\n    Open3.capture3(env, RbConfig.ruby, SCRIPT, *paths, *arguments, chdir: @root)\\n  end\\n\\n  def report\\n    out, err, status = run_report('--json')\\n    assert status.success?, err\\n    JSON.parse(out)\\n  end\\n\\n  def assert_invalid(fragment)\\n    out, err, status = run_report('--json')\\n    refute status.success?, 'Invalid input must fail instead of reporting zero debt.'\\n    assert_empty out\\n    assert_includes err, fragment\\n  end\\n\\n  def test_classification_counts_and_debt_do_not_fail\\n    data = report\\n    assert_equal 4, data.fetch('english_keys')\\n    de = data.fetch('locales').fetch('de')\\n    assert_equal ['a'], de.fetch('placeholders')\\n    assert_equal ['brand'], de.fetch('intentional')\\n    assert_equal ['z'], de.fetch('unreviewed_equal')\\n    assert_equal ['different'], de.fetch('different')\\n    assert_equal [], de.fetch('missing')\\n    assert_equal [], de.fetch('extra')\\n    assert_equal 1, de.fetch('counts').fetch('placeholders')\\n    assert_equal %w[a brand different z], data.fetch('locales').fetch('fr').fetch('unreviewed_equal')\\n    assert_equal %w[de fr it pt zh-Hans], data.fetch('locales').keys\\n  end\\n\\n  def test_missing_and_extra_are_separate\\n    strings('fr', '\\\"a\\\" = \\\"a\\\"; \\\"extra\\\" = \\\"Bonjour\\\";')\\n    fr = report.fetch('locales').fetch('fr')\\n    assert_equal %w[brand different z], fr.fetch('missing')\\n    assert_equal ['extra'], fr.fetch('extra')\\n    assert_equal ['a'], fr.fetch('unreviewed_equal')\\n  end\\n\\n  def test_native_comments_escapes_and_utf16\\n    metadata\\n    source = '/* \\\"fake\\\" = \\\"ignored\\\"; */ \\\"a\\\\\\\\U0062\\\" = \\\"line\\\\\\\\n\\\\\\\\\\\"quoted\\\\\\\\\\\"\\\"; // comment' + \\\"\\\\n\\\" + '\\\"\\\\\\\\U4F60\\\" = \\\"\\\\\\\\U597D\\\";'\\n    LOCALES.each { |locale| strings(locale, source) }\\n    path = File.join(@root, 'Cakebrew/de.lproj/Localizable.strings')\\n    File.binwrite(path, \\\"\\\\xFF\\\\xFE\\\".b + source.encode('UTF-16LE').b)\\n    assert_equal ['ab', '你'], report.fetch('locales').fetch('de').fetch('unreviewed_equal')\\n  end\\n\\n  def test_duplicate_literal_and_escaped_keys_are_rejected\\n    ['\\\"a\\\" = \\\"one\\\"; \\\"a\\\" = \\\"two\\\";', '\\\"a\\\" = \\\"one\\\"; \\\"\\\\\\\\U0061\\\" = \\\"two\\\";'].each do |source|\\n      strings('fr', source)\\n      assert_invalid('duplicate key')\\n    end\\n  end\\n\\n  def test_malformed_or_non_string_tables_fail\\n    ['\\\"a\\\" = \\\"unterminated;', '\\\"a\\\" = (\\\"array\\\");', '\\\"a\\\" = { \\\"nested\\\" = \\\"value\\\"; };'].each do |source|\\n      strings('fr', source)\\n      assert_invalid('fr')\\n    end\\n  end\\n\\n  def test_locale_inventory_cannot_silently_shrink_or_expand\\n    FileUtils.rm(File.join(@root, 'Cakebrew/fr.lproj/Localizable.strings'))\\n    assert_invalid('locale inventory')\\n    strings('fr', '\\\"a\\\" = \\\"a\\\";')\\n    strings('es', '\\\"a\\\" = \\\"a\\\";')\\n    assert_invalid('locale inventory')\\n  end\\n\\n  def test_metadata_is_strict_and_stale_entries_fail\\n    cases = [\\n      { 'version' => 2 }, { 'unknown' => [] }, { 'placeholders' => {} },\\n      { 'placeholders' => [{ 'key' => 'absent', 'locales' => ['de'], 'reason' => 'x' }] },\\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['en'], 'reason' => 'x' }] },\\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => [], 'reason' => 'x' }] },\\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de', 'de'], 'reason' => 'x' }] },\\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => ' ' }] },\\n      { 'placeholders' => [{ 'key' => 'different', 'locales' => ['de'], 'reason' => 'stale' }] },\\n      { 'placeholders' => [{ 'key' => 'a', 'locales' => ['de'], 'reason' => 'x', 'typo' => true }] }\\n    ]\\n    cases.each { |value| metadata(value); assert_invalid('metadata') }\\n    entry = { 'key' => 'a', 'locales' => ['de'], 'reason' => 'x' }\\n    metadata('placeholders' => [entry], 'intentional' => [entry])\\n    assert_invalid('metadata')\\n    metadata('placeholders' => [entry, entry])\\n    assert_invalid('metadata')\\n    File.write(@metadata, '{bad')\\n    assert_invalid('metadata')\\n  end\\n\\n  def test_markdown_is_deterministic_safe_and_summary_matches_stdout\\n    metadata\\n    LOCALES.each { |locale| strings(locale, '\\\"::error::\\\\\\\\n<script>`&\\\" = \\\"same\\\";') }\\n    summary = File.join(@root, 'summary.md')\\n    out, err, status = run_report('--summary', summary)\\n    assert status.success?, err\\n    assert_includes out, 'Different from English is not a translation-quality assessment.'\\n    assert_includes out, '&lt;script&gt;'\\n    refute_match(/^::error::/, out)\\n    refute_includes out, '<script>'\\n    assert_equal out, File.read(summary)\\n    assert_equal out, run_report.first\\n  end\\n\\n  def test_invalid_input_does_not_write_summary\\n    strings('de', 'broken')\\n    summary = File.join(@root, 'summary.md')\\n    _, _, status = run_report('--summary', summary)\\n    refute status.success?\\n    refute File.exist?(summary)\\n  end\\n\\n  def test_metadata_duplicate_json_fields_and_noninteger_version_fail\\n    File.write(@metadata, '{\\\"version\\\":2,\\\"version\\\":1,\\\"placeholders\\\":[],\\\"intentional\\\":[]}')\\n    assert_invalid('metadata')\\n    metadata('version' => 1.0)\\n    assert_invalid('metadata')\\n  end\\n\\n  def test_bounded_input_invalid_encoding_and_cli_errors\\n    strings('fr', ' ' * (2 * 1024 * 1024 + 1))\\n    assert_invalid('exceeds')\\n    strings('fr', \\\"\\\\xFF\\\".b)\\n    assert_invalid('encoding')\\n    _, err, status = run_report('--unknown')\\n    refute status.success?\\n    assert_includes err, 'invalid option'\\n    _, err, status = run_report('unexpected')\\n    refute status.success?\\n    assert_includes err, 'unexpected arguments'\\n  end\\n\\n  def test_default_paths_are_independent_of_current_directory_and_real_counts_match\\n    out, err, status = run_report('--json', default_root: true)\\n    assert status.success?, err\\n    data = JSON.parse(out)\\n    assert_equal 254, data.fetch('english_keys')\\n    { 'de' => 127, 'fr' => 124, 'it' => 126, 'pt' => 126, 'zh-Hans' => 137 }.each do |locale, expected|\\n      row = data.fetch('locales').fetch(locale)\\n      assert_equal expected, %w[placeholders intentional unreviewed_equal].sum { |category| row.fetch(category).length }\\n      assert_empty row.fetch('missing')\\n      assert_empty row.fetch('extra')\\n      assert_includes row.fetch('placeholders'), 'Remove Reviewed Dependencies'\\n      assert_includes row.fetch('intentional'), 'Cakebrew'\\n    end\\n  end\\n\\n  def test_native_formulae_values_preserve_existing_translations\\n    expected = { 'de' => 'Formeln', 'fr' => 'Formules', 'it' => 'Formule', 'pt' => 'Fórmulas', 'zh-Hans' => 'Formulae' }\\n    actual = expected.keys.to_h do |locale|\\n      path = File.join(ROOT, 'Cakebrew', \\\"#{locale}.lproj\\\", 'Localizable.strings')\\n      out, err, status = Open3.capture3('/usr/bin/plutil', '-convert', 'json', '-o', '-', '--', path)\\n      assert status.success?, err\\n      [locale, JSON.parse(out).fetch('Formulae')]\\n    end\\n    assert_equal expected, actual\\n  end\\n\\n  def test_ci_runs_tests_then_report_without_masking_errors\\n    source = File.read(File.join(ROOT, '.github/workflows/ci.yml'))\\n    assert_match(/ruby scripts\\\\/tests\\\\/localization-debt-tests\\\\.rb/, source)\\n    assert_match(/ruby scripts\\\\/localization-debt\\\\.rb --summary \\\"\\\\$GITHUB_STEP_SUMMARY\\\"/, source)\\n    assert_operator source.index('ruby scripts/tests/localization-debt-tests.rb'), :<, source.index('ruby scripts/localization-debt.rb')\\n    refute_includes source, 'continue-on-error'\\n  end\\nend\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a07e3a-7088-74f3-8263-cbdd479f00a0","create_time":1788824246.126449}}}
