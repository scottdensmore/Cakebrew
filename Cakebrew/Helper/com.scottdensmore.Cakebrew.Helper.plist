<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.scottdensmore.Cakebrew.Helper</string>
	<!-- Relative to the app bundle; SMAppService resolves it. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/CakebrewHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.scottdensmore.Cakebrew.Helper</key>
		<true/>
	</dict>
	<!-- Shows this as Cakebrew's background item in Login Items, rather than
	     as a bare launchd label. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.scottdensmore.Cakebrew</string>
	</array>
</dict>
</plist>
